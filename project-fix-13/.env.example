# KodYap Environment Configuration
# Copy to .env.local and fill in values

# ── App ──────────────────────────────────────────────────────────
VITE_APP_VERSION=0.1.0
VITE_APP_ENV=development

# ── Feature Flags ────────────────────────────────────────────────
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=false
VITE_DEBUG_LLM=false

# ── Default Provider ─────────────────────────────────────────────
# Override the default provider (default: pollinations — no key needed)
# Options: pollinations | gemini | groq | openrouter | together | huggingface | ollama | openai | anthropic
VITE_DEFAULT_PROVIDER=pollinations
VITE_DEFAULT_MODEL=openai
